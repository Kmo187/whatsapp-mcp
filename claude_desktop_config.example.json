{
  "mcpServers": {
    "whatsapp": {
      "command": "/absolute/path/to/uv",
      "args": [
        "--directory",
        "/absolute/path/to/whatsapp-mcp/whatsapp-mcp-server",
        "run",
        "main.py"
      ],
      "env": {
        "WHATSAPP_MCP_READ_ONLY": "0",
        "WHATSAPP_MCP_ALLOWED_RECIPIENTS": "",
        "WHATSAPP_MCP_ALLOWED_MEDIA_DIRS": ""
      }
    }
  }
}
