# Copy to .env and adjust. Used by docker compose; the same variables also work
# for a bridge started by hand and (where noted) in the MCP server's "env" block.

# Shared secret between bridge and MCP server. Required when the bridge listens
# on anything other than 127.0.0.1 (e.g. Docker). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_BRIDGE_TOKEN=

# Where the bridge listens (default 127.0.0.1:8080).
# WHATSAPP_BRIDGE_ADDR=127.0.0.1:8080

# Print message text in the bridge log (default off, logs stay private).
# WHATSAPP_LOG_CONTENT=0

# Time zone for logs inside Docker.
TZ=Europe/Zurich

# ---- MCP server only (set these in claude_desktop_config.json → "env") ----
# WHATSAPP_MCP_READ_ONLY=1
# WHATSAPP_MCP_ALLOWED_RECIPIENTS=41781234567,120363000000000000@g.us
# WHATSAPP_MCP_ALLOWED_MEDIA_DIRS=C:\Users\me\Documents\WhatsApp-Share
